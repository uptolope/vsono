# Copy to .env.local for development. Never commit real values.
# (See STATUS.md / todo.md for what each of these needs to point to.)

# Database
# DATABASE_URL is used by the app at runtime (Supabase: the pooled connection).
# DIRECT_URL is used by `prisma migrate` (Supabase: the direct connection).
# Give Preview its own database: a preview build runs migrations against
# whatever DATABASE_URL it is given (see scripts/maybe-migrate.cjs).
DATABASE_URL=
DIRECT_URL=

# NextAuth
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Resend (email)
RESEND_API_KEY=

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FLASHCARDS=
STRIPE_PRICE_PHYSICS_PEARLS=
STRIPE_PRICE_EXAM_SIMULATOR=
STRIPE_PRICE_STUDY_NOTES=
STRIPE_PRICE_PREMIUM_BUNDLE=

# Rate limiting (optional — falls back to a Postgres-backed counter without these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public
NEXT_PUBLIC_APP_URL=

# Vercel Blob (private storage for licensed Sonographic Physics page images)
BLOB_READ_WRITE_TOKEN=

# Analytics (Google Analytics 4). Tag only loads when set and never for DNT/GPC visitors.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GA4 Measurement Protocol API secret — enables server-side `purchase` events from the Stripe webhook
GA_API_SECRET=

# Lead emails (double opt-in + follow-ups).
# MAIL_POSTAL_ADDRESS (CAN-SPAM physical address) is required for ANY lead
#   email, including the confirmation link. Without it leads are stored but
#   nobody is ever emailed, so nobody can opt in.
# LEAD_NURTURE_ENABLED=true additionally turns on the follow-up sequence.
# CRON_SECRET authenticates Vercel's daily call to /api/cron/nurture (Vercel
#   sends it as "Authorization: Bearer <CRON_SECRET>"). Without it the route
#   answers 503 and unconfirmed addresses are never purged.
LEAD_NURTURE_ENABLED=false
MAIL_POSTAL_ADDRESS=
CRON_SECRET=
# Optional sender, e.g. "SonoPrep <hello@mail.sonoprep.com>". Must be on a
# domain verified in Resend. Defaults to SonoPrep <noreply@mail.sonoprep.com>.
EMAIL_FROM=
# Optional: a monitored mailbox. If set, follow-up emails invite replies.
EMAIL_REPLY_TO=

# Trust / E-E-A-T signals. Rendered ONLY when set — never invent these.
# Reviewer shown in the "About this resource" block on free reference pages.
NEXT_PUBLIC_REVIEWER_NAME=
NEXT_PUBLIC_REVIEWER_CREDENTIALS=
# Extra official profiles for Organization sameAs (comma-separated https URLs).
# LinkedIn + Instagram from the footer are already included.
NEXT_PUBLIC_SOCIAL_PROFILES=
